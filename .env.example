# App
SECRET_KEY=super-secret-key-change-in-production-please-32chars
DEBUG=True

# Database (Neon / Railway / Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/turnospro

# CORS (agregar tu dominio de Vercel)
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://tu-proyecto.vercel.app"]

# n8n
N8N_WEBHOOK_BASE_URL=https://tu-instancia.app.n8n.cloud/webhook
N8N_APPOINTMENT_CREATED_WEBHOOK=/appointment-created
N8N_APPOINTMENT_CANCELLED_WEBHOOK=/appointment-cancelled

# Frontend público (para links mágicos de cancelación)
PUBLIC_FRONTEND_URL=https://tu-proyecto.vercel.app
